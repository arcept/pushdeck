{
  "id": "figma",
  "name": "Figma",
  "description": "Figma shortcuts for tools, zoom and layout.",
  "author": {
    "name": "Arcept"
  },
  "source": {
    "kind": "bundled"
  },
  "slot": 2,
  "match": {
    "bundle_ids": [
      "com.figma.Desktop"
    ]
  },
  "theme": {
    "accent": "#0acf83",
    "bg": "#000000"
  },
  "controls": {
    "btn-upper-1": {
      "label": "Frame",
      "icon": "frame"
    },
    "btn-upper-2": {
      "label": "Rect",
      "icon": "rect"
    },
    "btn-upper-3": {
      "label": "Text",
      "icon": "text"
    },
    "btn-lower-1": {
      "label": "Undo",
      "icon": "undo"
    },
    "btn-lower-2": {
      "label": "Redo",
      "icon": "redo"
    },
    "pad-7-0": {
      "label": "Frame",
      "action": {
        "type": "keys",
        "keys": "f"
      },
      "color": "#ffcd29"
    },
    "pad-7-1": {
      "label": "Rectangle",
      "color": "#f24e1e",
      "action": {
        "type": "keys",
        "keys": "r"
      }
    },
    "pad-7-2": {
      "label": "Text",
      "color": "#0acf83",
      "action": {
        "type": "keys",
        "keys": "t"
      }
    }
  },
  "display": {
    "widgets": [
      {
        "type": "profile",
        "col": 6,
        "row": 0,
        "w": 2,
        "h": 1
      },
      {
        "type": "clock",
        "col": 0,
        "row": 0,
        "w": 2,
        "h": 2
      }
    ]
  }
}