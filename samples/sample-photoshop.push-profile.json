{
  "format": "push-profile",
  "schema_version": 1,
  "id": "photoshop-starter",
  "name": "Photoshop Starter",
  "description": "Brush, layer and export shortcuts, plus a cleanup script. Sample file for trying the import preview.",
  "author": { "name": "Alex Rivera", "url": "https://example.com/alex" },
  "match": { "bundle_ids": ["com.adobe.Photoshop", "com.figma.Desktop"] },
  "theme": { "accent": "#31a8ff", "bg": "#000000" },
  "controls": {
    "pad-7-0": { "label": "Brush", "color": "#31a8ff", "action": { "type": "keys", "keys": "b" } },
    "pad-7-1": { "label": "Layer", "color": "#31a8ff", "action": { "type": "keys", "keys": "cmd+shift+n" } },
    "pad-7-2": { "label": "Export", "color": "#0acf83", "action": { "type": "keys", "keys": "cmd+alt+shift+w" } },
    "pad-7-3": { "label": "Tidy", "color": "#f24e1e", "risky": true, "action": { "type": "shell", "command": "find ~/Downloads -name '*.psd' -mtime +30 -delete" } },
    "pad-7-4": { "label": "Reference", "color": "#ffcd29", "action": { "type": "url", "url": "https://example.com/references" } },
    "pad-7-5": { "label": "Notes", "color": "#a259ff", "action": { "type": "app", "name": "Notes" } },
    "btn-upper-1": { "label": "Undo", "action": { "type": "keys", "keys": "cmd+z" } },
    "not-a-real-control": { "label": "Ignored" }
  }
}
